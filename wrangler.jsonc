{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "d2-camera",
  "main": "index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*"
    ],
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACORD_REALTIME",
        "class_name": "AcordRealtime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AcordRealtime"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}
