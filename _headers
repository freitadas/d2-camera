/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' ws: wss: https://tenor.googleapis.com; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; frame-src 'none'; child-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

/index.html
  Cache-Control: no-store, no-cache, must-revalidate

/index-v683.html
  Cache-Control: no-store, no-cache, must-revalidate

/runtime-v683.js
  Cache-Control: no-store, no-cache, must-revalidate

/bootstrap-v683.js
  Cache-Control: no-store, no-cache, must-revalidate

/bundle-v683.js
  Cache-Control: no-store, no-cache, must-revalidate

/app-v683.css
