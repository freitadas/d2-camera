{
  "name": "acord-cloudflare",
  "version": "6.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "test": "node build-assets.mjs --check && node test-smoke.mjs && node test-security.mjs && node test-scalability.mjs",
    "verify": "npm test && npm run check",
    "test:security": "node test-security.mjs",
    "test:security:e2e": "node test-security-e2e.mjs",
    "build:assets": "node build-assets.mjs",
    "check:generated": "node build-assets.mjs --check"
  },
  "devDependencies": {
    "wrangler": "4.68.0"
  },
  "engines": {
    "node": ">=22"
  }
}
